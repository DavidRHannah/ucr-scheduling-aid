flowchart TD
    A["User on /schedule-builder"] --> B["Right sidebar: CourseSearchPanel"]
    
    subgraph CourseSearch ["Course Search Panel (Right Sidebar, 360px)"]
        B --> C["Course Cart (empty initially)"]
        C --> D["Search input + Department dropdown"]
        D --> E["GET /api/courses?page=1&limit=15&search=...&subject=..."]
        E --> F["Results list with +/- buttons"]
    end
    
    F --> G{"User clicks + on a course"}
    G --> H["Course added to selectedCourses state\nBadge appears in cart"]
    H --> I{"Add more courses?"}
    I -->|Yes| G
    I -->|No| J["User clicks 'Generate Combinations'"]
    
    J --> K["POST /api/generate\nbody: courseIds, termCode, lockedSectionIds"]
    K -->|Success| L["combinations state populated"]
    K -->|Error| M["console.error only\nNo user-visible error"]
    
    L --> N["StatusBanner shows count\n(hardcoded 0.05s time)"]
    N --> O["First combo auto-selected\nWeeklyCalendar renders sections"]
    O --> P["Section Control panel shows\nall sections with lock/unlock icons"]
    
    P --> Q{"User clicks lock icon?"}
    Q -->|Yes| R["Section added to lockedSections\nuseEffect triggers re-generation\nPOST /api/generate again"]
    R --> L
    
    Q -->|No| S["CombinationsList shows below calendar\n3 visible initially, expandable"]
    S --> T{"User clicks 'Preview'\non a different combo"}
    T --> U["selectedComboIndex updates\nCalendar re-renders new sections"]
    
    U --> V{"User wants to save?"}
    V -->|Not signed in| W["Save form is hidden\nNo explanation shown"]
    V -->|Signed in| X["Name input + Save button appear"]
    X --> Y["POST /api/schedules\nbody: name, termCode, sectionIds"]
    Y -->|Success| Z["Green success banner\nNo link to Saved Schedules"]
    Y -->|Error| AA["Red error banner with message"]
    
    style M fill:#fee,stroke:#c00
    style W fill:#fee,stroke:#c00
    style Z fill:#ffd,stroke:#aa0
