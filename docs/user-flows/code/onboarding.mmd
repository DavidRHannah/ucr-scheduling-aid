flowchart TD
    A["User visits app"] --> B["Lands on / (Dashboard)"]
    B --> C{"Dashboard shows 'Coming soon.'"}
    C --> D["User is confused, explores sidebar"]
    D --> E{"User clicks Schedule Builder"}
    E --> F["Builder loads with empty state"]
    F --> G{"Course cart is empty\nCalendar is blank\nStatusBanner incorrectly says\n'Found 0 compatible combinations!'"}
    G --> H["User must discover the\nright sidebar search panel"]
    H --> I{"Search returns results\nonly if data has been\nsynced via Settings first"}
    I -->|No data synced| J["Empty results with hint:\n'Run ingestion sync on Settings'"]
    I -->|Data exists| K["User can add courses to cart"]
    J --> L["User navigates to Settings\nto find the sync panel"]
    L --> M{"Sync requires admin API key\nthat a student would not have"}
    M --> N["Dead end -- user cannot\nself-serve data loading"]

    style C fill:#fee,stroke:#c00
    style G fill:#fee,stroke:#c00
    style M fill:#fee,stroke:#c00
    style N fill:#f99,stroke:#c00
