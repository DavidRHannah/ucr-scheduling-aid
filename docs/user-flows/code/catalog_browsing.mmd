flowchart TD
    A["User on /course-search"] --> B["Left panel: catalog search list"]
    
    subgraph SearchPanel ["Search and Browse (Left Panel)"]
        B --> C["Search input + Department Select + Search button"]
        C --> D["GET /api/courses?page=N&limit=10&search=...&subject=..."]
        D --> E["Course cards with subject, number, title, units, description"]
        E --> F["Pagination: Previous / Page N of M / Next"]
    end
    
    E --> G{"User clicks a course card"}
    G --> H["selectedCourse state set"]
    
    subgraph DetailPanel ["Details Side Panel (Right, 400px)"]
        H --> I["Course header: subject, number, title\nCollege + Department badges"]
        I --> J["Course description text"]
        J --> K["GET /api/courses/:id/prerequisites"]
        K --> L{"Prerequisites exist?"}
        L -->|Yes| M["Rule groups rendered\nEach shows options with\nmin grade and concurrent flags"]
        L -->|No| N["'No prerequisites registered'"]
        
        J --> O["GET /api/sections/course/:id?termCode=202620"]
        O --> P{"Sections exist?"}
        P -->|Yes| Q["Section cards showing:\ntype, number, CRN, meeting times,\ndays, building/room, instructor,\nstatus (Open/Closed), enrollment"]
        P -->|No| R["'No sections scheduled for this term'"]
    end
    
    Q --> S{"User wants to add\nthis course to a schedule?"}
    S --> T["No mechanism exists.\nUser must manually go to\nSchedule Builder and search again."]
    
    style T fill:#fee,stroke:#c00
